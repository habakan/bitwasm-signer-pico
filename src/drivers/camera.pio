; Takes only the Y of YUV422 (Y U Y V ...) from an 8-bit parallel DVP camera, giving greyscale.
; IN is based at D0, and D0-D7, PCLK, HREF and VSYNC are assumed to run consecutively in that order
; (board_pins.h). The CPU puts the pixels-per-row minus one into the TX FIFO once before starting.
; Autopush fires every four pixels and DMA takes it from there.
;
; The sensor is left emitting VGA (640x480) and halved in both directions here to give QVGA: across,
; only the first Y of every four bytes (two pixels); down, one row skipped for each row captured.
; Nothing depends on the sensor's own scaler, whose vertical half had no effect on the OV7675, so
; modules of different provenance all yield the same picture.

.program dvp_y
.define PUBLIC PCLK 8
.define PUBLIC HREF 9
.define PUBLIC VSYNC 10
    pull block              ; OSR = pixels per row, minus one
    wait 1 pin VSYNC        ; the frame starts where the VSYNC pulse ends
    wait 0 pin VSYNC
.wrap_target
    mov x, osr
    wait 1 pin HREF         ; start of a row
pixel:
    wait 1 pin PCLK         ; byte 1, the Y, is settled on PCLK's rising edge
    in pins, 8
    wait 0 pin PCLK
    wait 1 pin PCLK         ; byte 2, the U
    wait 0 pin PCLK
    wait 1 pin PCLK         ; byte 3, the next pixel's Y, is dropped
    wait 0 pin PCLK
    wait 1 pin PCLK         ; byte 4, the V
    wait 0 pin PCLK
    jmp x-- pixel
    wait 0 pin HREF         ; end of the row
    wait 1 pin HREF         ; and skip the next row
    wait 0 pin HREF
.wrap

% c-sdk {
#include "hardware/clocks.h"

static inline void dvp_y_program_init(PIO pio, uint sm, uint offset, uint pin_d0) {
    pio_sm_config c = dvp_y_program_get_default_config(offset);
    for (uint i = 0; i < 11; i++) pio_gpio_init(pio, pin_d0 + i);
    pio_sm_set_consecutive_pindirs(pio, sm, pin_d0, 11, false);
    sm_config_set_in_pins(&c, pin_d0);
    /* Shifting right and pushing at four bytes puts the first pixel in the word's low byte */
    sm_config_set_in_shift(&c, true, true, 32);
    /* Joining the RX FIFO would remove the TX one and stall that first pull forever; four RX entries
     * and DMA are enough */
    pio_sm_init(pio, sm, offset, &c);
}
%}
